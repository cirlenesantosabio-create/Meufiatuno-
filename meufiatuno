<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Meu Fiat Uno CHT 3D</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            user-select: none;
            -webkit-user-select: none;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }
        body, html {
            width: 100%;
            height: 100%;
            overflow: hidden;
            background-color: #000;
        }
        #game-container {
            width: 100%;
            height: 100%;
            position: relative;
        }
        canvas {
            width: 100%;
            height: 100%;
            display: block;
        }
        
        /* UI HUD Overlay */
        #hud {
            position: absolute;
            top: 12px;
            left: 12px;
            color: #fff;
            text-shadow: 1px 1px 3px rgba(0,0,0,0.8);
            pointer-events: none;
            z-index: 10;
        }
        .hud-card {
            background: rgba(15, 23, 42, 0.75);
            backdrop-filter: blur(8px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 10px 16px;
            border-radius: 12px;
            margin-bottom: 8px;
            display: inline-block;
        }
        .hud-title {
            font-size: 16px;
            font-weight: 800;
            color: #f59e0b;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .hud-stats {
            font-size: 14px;
            margin-top: 4px;
            font-weight: 600;
        }
        #status-msg {
            position: absolute;
            top: 12px;
            left: 50%;
            transform: translateX(-50%);
            background: rgba(0,0,0,0.8);
            color: #38bdf8;
            padding: 8px 16px;
            border-radius: 20px;
            font-size: 13px;
            font-weight: bold;
            pointer-events: none;
            z-index: 10;
            border: 1px solid rgba(56, 189, 248, 0.3);
            text-align: center;
        }

        /* Action Buttons */
        .btn-group {
            position: absolute;
            top: 12px;
            right: 12px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            z-index: 20;
        }
        .btn {
            background: linear-gradient(135deg, #1e293b, #0f172a);
            color: #f8fafc;
            border: 1px solid rgba(255, 255, 255, 0.2);
            padding: 12px 18px;
            border-radius: 10px;
            font-weight: bold;
            font-size: 13px;
            cursor: pointer;
            box-shadow: 0 4px 6px rgba(0,0,0,0.3);
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .btn:active {
            transform: scale(0.95);
        }
        .btn-primary { background: linear-gradient(135deg, #2563eb, #1d4ed8); }
        .btn-success { background: linear-gradient(135deg, #16a34a, #15803d); }
        .btn-warning { background: linear-gradient(135deg, #d97706, #b45309); }

        /* Interaction Prompts Bottom Right */
        #interaction-panel {
            position: absolute;
            bottom: 24px;
            right: 24px;
            display: flex;
            flex-direction: column;
            gap: 12px;
            z-index: 20;
        }

        /* Touch Controls Joystick */
        #joystick-zone {
            position: absolute;
            bottom: 30px;
            left: 30px;
            width: 120px;
            height: 120px;
            background: rgba(255, 255, 255, 0.1);
            border: 2px solid rgba(255, 255, 255, 0.25);
            border-radius: 60px;
            z-index: 20;
            touch-action: none;
        }
        #joystick-knob {
            position: absolute;
            top: 35px;
            left: 35px;
            width: 50px;
            height: 50px;
            background: rgba(245, 158, 11, 0.8);
            border-radius: 25px;
            box-shadow: 0 0 10px rgba(0,0,0,0.5);
            pointer-events: none;
        }

        /* Hunger Bar */
        .progress-bar {
            width: 100px;
            height: 8px;
            background: rgba(255,255,255,0.2);
            border-radius: 4px;
            display: inline-block;
            vertical-align: middle;
            overflow: hidden;
            margin-left: 6px;
        }
        .progress-fill {
            height: 100%;
            background: #ef4444;
            width: 100%;
            transition: width 0.3s ease;
        }
    </style>
    <!-- Three.js engine -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>
</head>
<body>
    <div id="game-container">
        <!-- HUD -->
        <div id="hud">
            <div class="hud-card">
                <div class="hud-title">🚗 Meu Fiat Uno CHT</div>
                <div class="hud-stats">
                    Dinheiro: <span id="money-txt" style="color:#4ade80;">$150</span><br>
                    Fome: <div class="progress-bar"><div id="hunger-bar" class="progress-fill"></div></div>
                </div>
            </div>
        </div>

        <div id="status-msg">Explore a garagem e pegue a maleta de ferramentas na bancada.</div>

        <!-- Top Right Control Buttons -->
        <div class="btn-group">
            <button id="btn-gate" class="btn btn-warning">🚪 ABRIR PORTÃO</button>
            <button id="btn-cam" class="btn btn-primary">🎥 CÂMERA (3ª P)</button>
        </div>

        <!-- Bottom Right Dynamic Context Actions -->
        <div id="interaction-panel">
            <button id="btn-enter" class="btn btn-success" style="display: none;">🚗 ENTRAR NO FIAT UNO</button>
            <button id="btn-hood" class="btn btn-warning" style="display: none;">🔧 ABRIR CAPÔ / MOTOR CHT</button>
            <button id="btn-tool" class="btn btn-primary" style="display: none;">🧰 PEGAR MALETA</button>
            <button id="btn-freight" class="btn btn-success" style="display: none;">📦 PEGAR FRETE ($150)</button>
            <button id="btn-eat" class="btn btn-warning" style="display: none;">🌭 COMER LANCHE ($20)</button>
        </div>

        <!-- Touch Controls -->
        <div id="joystick-zone">
            <div id="joystick-knob"></div>
        </div>
    </div>

    <script>
        // Game State Variables
        const state = {
            money: 150,
            hunger: 100,
            hasToolbox: false,
            gateOpen: false,
            inCar: false,
            hoodOpen: false,
            hasCargo: false,
            camMode: 0, // 0: 3rd Person Orbit, 1: Cockpit/Volante, 2: CHT Engine View
            playerPos: new THREE.Vector3(2, 0.9, 2),
            playerRot: 0,
            carPos: new THREE.Vector3(0, 0.6, 0),
            carRot: 0,
            carSpeed: 0,
            touchX: 0,
            touchY: 0,
            isSwiping: false,
            lastMouseX: 0,
            lastMouseY: 0,
            camYaw: 0,
            camPitch: 0.3
        };

        // DOM Element Refs
        const moneyTxt = document.getElementById('money-txt');
        const hungerBar = document.getElementById('hunger-bar');
        const statusMsg = document.getElementById('status-msg');
        const btnGate = document.getElementById('btn-gate');
        const btnCam = document.getElementById('btn-cam');
        const btnEnter = document.getElementById('btn-enter');
        const btnHood = document.getElementById('btn-hood');
        const btnTool = document.getElementById('btn-tool');
        const btnFreight = document.getElementById('btn-freight');
        const btnEat = document.getElementById('btn-eat');

        const container = document.getElementById('game-container');
        const scene = new THREE.Scene();
        scene.background = new THREE.Color(0x87ceeb);
        scene.fog = new THREE.FogExp2(0x87ceeb, 0.012);

        const camera = new THREE.PerspectiveCamera(60, window.innerWidth / window.innerHeight, 0.1, 1000);
        const renderer = new THREE.WebGLRenderer({ antialias: true, powerPreference: "high-performance" });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
        renderer.shadowMap.enabled = true;
        renderer.shadowMap.type = THREE.PCFSoftShadowMap;
        container.appendChild(renderer.domElement);

        // Lighting
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.6);
        scene.add(ambientLight);

        const sunLight = new THREE.DirectionalLight(0xffffff, 0.8);
        sunLight.position.set(30, 50, 20);
        sunLight.castShadow = true;
        sunLight.shadow.mapSize.width = 1024;
        sunLight.shadow.mapSize.height = 1024;
        sunLight.shadow.camera.near = 0.5;
        sunLight.shadow.camera.far = 150;
        const d = 40;
        sunLight.shadow.camera.left = -d;
        sunLight.shadow.camera.right = d;
        sunLight.shadow.camera.top = d;
        sunLight.shadow.camera.bottom = -d;
        scene.add(sunLight);

        // Ground Mesh
        const groundGeo = new THREE.PlaneGeometry(300, 300);
        const groundMat = new THREE.MeshLambertMaterial({ color: 0x355e3b });
        const ground = new THREE.Mesh(groundGeo, groundMat);
        ground.rotation.x = -Math.PI / 2;
        ground.receiveShadow = true;
        scene.add(ground);

        // Roads
        const roadMat = new THREE.MeshLambertMaterial({ color: 0x333333 });
        const mainRoad = new THREE.Mesh(new THREE.PlaneGeometry(16, 200), roadMat);
        mainRoad.rotation.x = -Math.PI / 2;
        mainRoad.position.set(0, 0.01, 40);
        mainRoad.receiveShadow = true;
        scene.add(mainRoad);

        // Bounding Boxes array for Collisions
        const collisionBoxes = [];

        function createBuilding(x, z, width, depth, height, color, name) {
            const group = new THREE.Group();
            const mesh = new THREE.Mesh(
                new THREE.BoxGeometry(width, height, depth),
                new THREE.MeshLambertMaterial({ color: color })
            );
            mesh.position.y = height / 2;
            mesh.castShadow = true;
            mesh.receiveShadow = true;
            group.add(mesh);

            // Roof
            const roof = new THREE.Mesh(
                new THREE.BoxGeometry(width + 0.4, 0.4, depth + 0.4),
                new THREE.MeshLambertMaterial({ color: 0x1e293b })
            );
            roof.position.y = height + 0.2;
            group.add(roof);

            group.position.set(x, 0, z);
            scene.add(group);

            // Store Bounding Box
            const bbox = new THREE.Box3().setFromObject(group);
            collisionBoxes.push({ box: bbox, name: name });

            return group;
        }

        // World Buildings
        const house = createBuilding(-15, -10, 10, 12, 4, 0xe2e8f0, "Casa");
        const workshop = createBuilding(18, 15, 12, 14, 5, 0x94a3b8, "Oficina");
        const warehouse = createBuilding(-20, 40, 16, 20, 6, 0x64748b, "Galpão Frete");
        const supermarket = createBuilding(22, 60, 18, 18, 5, 0x38bdf8, "Supermercado");

        // Special Garage Structure (Allows hiding front wall)
        const garageGroup = new THREE.Group();
        garageGroup.position.set(0, 0, 0);

        const wallMat = new THREE.MeshLambertMaterial({ color: 0xc2c5cc });

        // Back Wall
        const backWall = new THREE.Mesh(new THREE.BoxGeometry(8, 4, 0.3), wallMat);
        backWall.position.set(0, 2, -5);
        garageGroup.add(backWall);

        // Left Wall
        const leftWall = new THREE.Mesh(new THREE.BoxGeometry(0.3, 4, 10), wallMat);
        leftWall.position.set(-4, 2, 0);
        garageGroup.add(leftWall);

        // Right Wall
        const rightWall = new THREE.Mesh(new THREE.BoxGeometry(0.3, 4, 10), wallMat);
        rightWall.position.set(4, 2, 0);
        garageGroup.add(rightWall);

        // Roof
        const garageRoof = new THREE.Mesh(new THREE.BoxGeometry(8.4, 0.3, 10.4), new THREE.MeshLambertMaterial({ color: 0x334155 }));
        garageRoof.position.set(0, 4.15, 0);
        garageGroup.add(garageRoof);

        // FRONT WALL (The one that will be hidden when gate opens)
        const frontWall = new THREE.Mesh(new THREE.BoxGeometry(8, 4, 0.3), wallMat);
        frontWall.position.set(0, 2, 5);
        garageGroup.add(frontWall);

        // Garage Gate (Sliding door)
        const gateMat = new THREE.MeshLambertMaterial({ color: 0x475569 });
        const garageGate = new THREE.Mesh(new THREE.BoxGeometry(7.6, 3.8, 0.1), gateMat);
        garageGate.position.set(0, 1.9, 4.95);
        garageGroup.add(garageGate);

        // Workbench inside Garage
        const workbench = new THREE.Mesh(new THREE.BoxGeometry(2.5, 0.9, 1), new THREE.MeshLambertMaterial({ color: 0x78350f }));
        workbench.position.set(-2.5, 0.45, -3.8);
        garageGroup.add(workbench);

        // Toolbox Object
        const toolboxGroup = new THREE.Group();
        const tbMesh = new THREE.Mesh(new THREE.BoxGeometry(0.6, 0.3, 0.4), new THREE.MeshLambertMaterial({ color: 0xd97706 }));
        toolboxGroup.add(tbMesh);
        toolboxGroup.position.set(-2.5, 1.05, -3.8);
        garageGroup.add(toolboxGroup);

        scene.add(garageGroup);

        // Register Garage Static Collisions (Walls except gate opening)
        const garageBackBox = new THREE.Box3().setFromObject(backWall);
        const garageLeftBox = new THREE.Box3().setFromObject(leftWall);
        const garageRightBox = new THREE.Box3().setFromObject(rightWall);
        collisionBoxes.push({ box: garageBackBox, name: "Garagem Fundo" });
        collisionBoxes.push({ box: garageLeftBox, name: "Garagem Esquerda" });
        collisionBoxes.push({ box: garageRightBox, name: "Garagem Direita" });

        // Fiat Uno 3D Model Assembly
        const fiatUno = new THREE.Group();

        // Main Body (Square Boxy shape characteristic of Fiat Uno)
        const bodyMat = new THREE.MeshLambertMaterial({ color: 0xd97706 }); // Classic Ochre / Red
        const carBody = new THREE.Mesh(new THREE.BoxGeometry(1.8, 1.0, 3.6), bodyMat);
        carBody.position.y = 0.7;
        carBody.castShadow = true;
        fiatUno.add(carBody);

        // Cabin / Windows
        const cabinMat = new THREE.MeshLambertMaterial({ color: 0x1e293b });
        const cabin = new THREE.Mesh(new THREE.BoxGeometry(1.7, 0.7, 2.0), cabinMat);
        cabin.position.set(0, 1.45, -0.2);
        cabin.castShadow = true;
        fiatUno.add(cabin);

        // Hood / Capô (Interactive)
        const hoodGroup = new THREE.Group();
        hoodGroup.position.set(0, 1.15, 0.8);
        const hoodMesh = new THREE.Mesh(new THREE.BoxGeometry(1.72, 0.08, 1.1), bodyMat);
        hoodMesh.position.set(0, 0, 0.55);
        hoodGroup.add(hoodMesh);
        fiatUno.add(hoodGroup);

        // CHT Engine Block (Under Hood)
        const chtEngine = new THREE.Group();
        const engBlock = new THREE.Mesh(new THREE.BoxGeometry(0.8, 0.5, 0.7), new THREE.MeshLambertMaterial({ color: 0x475569 }));
        engBlock.position.set(0, 0.75, 1.1);
        chtEngine.add(engBlock);
        
        const filterCap = new THREE.Mesh(new THREE.CylinderGeometry(0.25, 0.25, 0.15), new THREE.MeshLambertMaterial({ color: 0xef4444 }));
        filterCap.position.set(0, 1.05, 1.1);
        chtEngine.add(filterCap);
        fiatUno.add(chtEngine);

        // Wheels
        const wheelGeo = new THREE.CylinderGeometry(0.32, 0.32, 0.22, 16);
        const wheelMat = new THREE.MeshLambertMaterial({ color: 0x0f172a });
        
        const wheelPositions = [
            [-0.85, 0.32, 1.1],
            [0.85, 0.32, 1.1],
            [-0.85, 0.32, -1.1],
            [0.85, 0.32, -1.1]
        ];

        wheelPositions.forEach(pos => {
            const wheel = new THREE.Mesh(wheelGeo, wheelMat);
            wheel.rotation.z = Math.PI / 2;
            wheel.position.set(...pos);
            wheel.castShadow = true;
            fiatUno.add(wheel);
        });

        // Set initial car position inside garage
        fiatUno.position.copy(state.carPos);
        scene.add(fiatUno);

        // Player 3D Mesh
        const playerGroup = new THREE.Group();
        const playerBody = new THREE.Mesh(
            new THREE.CylinderGeometry(0.35, 0.35, 1.4, 12),
            new THREE.MeshLambertMaterial({ color: 0x0284c7 })
        );
        playerBody.position.y = 0.7;
        playerBody.castShadow = true;
        playerGroup.add(playerBody);

        const playerHead = new THREE.Mesh(
            new THREE.SphereGeometry(0.25, 12, 12),
            new THREE.MeshLambertMaterial({ color: 0xfde047 })
        );
        playerHead.position.y = 1.55;
        playerHead.castShadow = true;
        playerGroup.add(playerHead);

        playerGroup.position.copy(state.playerPos);
        scene.add(playerGroup);

        // Gate Toggle (Opens Gate AND hides front garage wall completely)
        btnGate.addEventListener('click', () => {
            state.gateOpen = !state.gateOpen;
            
            if (state.gateOpen) {
                garageGate.position.y = 5.5; // Slide gate UP
                frontWall.visible = false;   // HIDE FRONT WALL completely
                btnGate.innerText = "🚪 FECHAR PORTÃO";
                statusMsg.innerText = "Portão aberto! Garagem desobstruída.";
            } else {
                garageGate.position.y = 1.9;  // Slide gate DOWN
                frontWall.visible = true;    // SHOW FRONT WALL
                btnGate.innerText = "🚪 ABRIR PORTÃO";
                statusMsg.innerText = "Portão fechado.";
            }
        });

        // Camera Switcher
        btnCam.addEventListener('click', () => {
            state.camMode = (state.camMode + 1) % 3;
            const names = ["🎥 CÂMERA (3ª P)", "🎥 CÂMERA (VOLANTE)", "🎥 CÂMERA (CHT)"];
            btnCam.innerText = names[state.camMode];
        });

        // Enter/Exit Car
        btnEnter.addEventListener('click', () => {
            state.inCar = !state.inCar;
            playerGroup.visible = !state.inCar;
            
            if (state.inCar) {
                btnEnter.innerText = "🚶 SAIR DO FIAT UNO";
                statusMsg.innerText = "Você entrou no Fiat Uno CHT. Dirija usando o joystick!";
            } else {
                btnEnter.innerText = "🚗 ENTRAR NO FIAT UNO";
                // Place player beside driver door
                state.playerPos.copy(fiatUno.position).add(new THREE.Vector3(1.5, 0, 0));
                playerGroup.position.copy(state.playerPos);
                statusMsg.innerText = "Você saiu do veículo.";
            }
        });

        // Hood Toggle
        btnHood.addEventListener('click', () => {
            state.hoodOpen = !state.hoodOpen;
            hoodGroup.rotation.x = state.hoodOpen ? -Math.PI / 3 : 0;
            statusMsg.innerText = state.hoodOpen ? "Capô aberto! Motor CHT exposto." : "Capô fechado.";
        });

        // Pick Toolbox
        btnTool.addEventListener('click', () => {
            state.hasToolbox = true;
            toolboxGroup.visible = false;
            btnTool.style.display = 'none';
            statusMsg.innerText = "Maleta de ferramentas adquirida! Agora você pode dar manutenção no motor.";
        });

        // Freight Mission Action
        btnFreight.addEventListener('click', () => {
            if (!state.hasCargo) {
                state.hasCargo = true;
                statusMsg.innerText = "Carga de frete pego no galpão! Entregue no Supermercado.";
            } else {
                state.hasCargo = false;
                state.money += 150;
                moneyTxt.innerText = `$${state.money}`;
                statusMsg.innerText = "Entrega concluída com sucesso! Ganhou $150!";
            }
        });

        // Eat Snack
        btnEat.addEventListener('click', () => {
            if (state.money >= 20) {
                state.money -= 20;
                state.hunger = Math.min(100, state.hunger + 40);
                moneyTxt.innerText = `$${state.money}`;
                hungerBar.style.width = `${state.hunger}%`;
                statusMsg.innerText = "Lanche consumido! Fome recuperada.";
            } else {
                statusMsg.innerText = "Dinheiro insuficiente para comer!";
            }
        });

        // Virtual Joystick Touch Engine
        const joystickZone = document.getElementById('joystick-zone');
        const joystickKnob = document.getElementById('joystick-knob');
        let joyActive = false;
        let joyOrigin = { x: 0, y: 0 };

        function handleTouchStart(e) {
            const touch = e.touches[0];
            const rect = joystickZone.getBoundingClientRect();
            if (touch.clientX >= rect.left && touch.clientX <= rect.right &&
                touch.clientY >= rect.top && touch.clientY <= rect.bottom) {
                joyActive = true;
                joyOrigin = { x: rect.left + rect.width / 2, y: rect.top + rect.height / 2 };
            }
        }

        function handleTouchMove(e) {
            if (!joyActive) return;
            const touch = e.touches[0];
            const dx = touch.clientX - joyOrigin.x;
            const dy = touch.clientY - joyOrigin.y;
            const dist = Math.min(40, Math.hypot(dx, dy));
            const angle = Math.atan2(dy, dx);

            const knobX = Math.cos(angle) * dist;
            const knobY = Math.sin(angle) * dist;

            joystickKnob.style.transform = `translate(${knobX}px, ${knobY}px)`;

            state.touchX = knobX / 40; // Normalized -1 to 1
            state.touchY = knobY / 40;
        }

        function handleTouchEnd() {
            joyActive = false;
            joystickKnob.style.transform = `translate(0px, 0px)`;
            state.touchX = 0;
            state.touchY = 0;
        }

        window.addEventListener('touchstart', handleTouchStart, { passive: true });
        window.addEventListener('touchmove', handleTouchMove, { passive: true });
        window.addEventListener('touchend', handleTouchEnd);

        // Swipe Screen to Orbit Camera 360
        window.addEventListener('mousedown', (e) => {
            if (e.clientX > window.innerWidth * 0.3) {
                state.isSwiping = true;
                state.lastMouseX = e.clientX;
                state.lastMouseY = e.clientY;
            }
        });

        window.addEventListener('mousemove', (e) => {
            if (!state.isSwiping) return;
            const dx = e.clientX - state.lastMouseX;
            const dy = e.clientY - state.lastMouseY;
            state.camYaw -= dx * 0.005;
            state.camPitch = Math.max(0.1, Math.min(1.2, state.camPitch + dy * 0.005));
            state.lastMouseX = e.clientX;
            state.lastMouseY = e.clientY;
        });

        window.addEventListener('mouseup', () => state.isSwiping = false);

        function checkCollision(newPos, radius) {
            const playerBox = new THREE.Box3(
                new THREE.Vector3(newPos.x - radius, 0, newPos.z - radius),
                new THREE.Vector3(newPos.x + radius, 2, newPos.z + radius)
            );

            // Check against gate if closed
            if (!state.gateOpen) {
                const gateBox = new THREE.Box3().setFromObject(garageGate);
                if (playerBox.intersectsBox(gateBox)) return true;
            }

            // Check buildings
            for (let item of collisionBoxes) {
                if (playerBox.intersectsBox(item.box)) {
                    return true;
                }
            }
            return false;
        }

        const clock = new THREE.Clock();

        function animate() {
            requestAnimationFrame(animate);
            const delta = clock.getDelta();

            // Movement Logic
            const speedScale = 8.0 * delta;

            if (state.inCar) {
                // Driving Fiat Uno CHT
                if (Math.abs(state.touchY) > 0.1) {
                    state.carSpeed = -state.touchY * 12.0 * delta;
                } else {
                    state.carSpeed *= 0.92; // Friction
                }

                if (Math.abs(state.carSpeed) > 0.01) {
                    if (state.touchX !== 0) {
                        state.carRot -= state.touchX * 2.0 * delta * Math.sign(state.carSpeed);
                    }
                }

                const moveVec = new THREE.Vector3(0, 0, state.carSpeed).applyAxisAngle(new THREE.Vector3(0, 1, 0), state.carRot);
                const nextCarPos = fiatUno.position.clone().add(moveVec);

                if (!checkCollision(nextCarPos, 1.2)) {
                    fiatUno.position.copy(nextCarPos);
                    fiatUno.rotation.y = state.carRot;
                } else {
                    state.carSpeed = 0; // Stop on rigid collision
                }
            } else {
                // Walking on Foot
                if (Math.abs(state.touchX) > 0.1 || Math.abs(state.touchY) > 0.1) {
                    const moveAngle = Math.atan2(state.touchX, state.touchY) + state.camYaw;
                    const moveVec = new THREE.Vector3(Math.sin(moveAngle), 0, Math.cos(moveAngle)).multiplyScalar(speedScale);
                    const nextPlayerPos = playerGroup.position.clone().add(moveVec);

                    if (!checkCollision(nextPlayerPos, 0.4)) {
                        playerGroup.position.copy(nextPlayerPos);
                        playerGroup.rotation.y = moveAngle;
                    }
                }
            }

            // Camera Targeting & Follow Behavior
            const targetPos = state.inCar ? fiatUno.position : playerGroup.position;

            if (state.camMode === 0) {
                // 3rd Person Orbit
                const dist = state.inCar ? 7.0 : 4.5;
                const camX = targetPos.x + Math.sin(state.camYaw) * dist * Math.cos(state.camPitch);
                const camZ = targetPos.z + Math.cos(state.camYaw) * dist * Math.cos(state.camPitch);
                const camY = targetPos.y + Math.sin(state.camPitch) * dist + 1.2;

                camera.position.set(camX, camY, camZ);
                camera.lookAt(targetPos.x, targetPos.y + 1.0, targetPos.z);
            } else if (state.camMode === 1) {
                // Cockpit View / Volante
                if (state.inCar) {
                    const cockpitOffset = new THREE.Vector3(-0.35, 1.3, -0.2).applyAxisAngle(new THREE.Vector3(0, 1, 0), state.carRot);
                    camera.position.copy(fiatUno.position).add(cockpitOffset);
                    const lookTarget = fiatUno.position.clone().add(new THREE.Vector3(0, 1.2, 5).applyAxisAngle(new THREE.Vector3(0, 1, 0), state.carRot));
                    camera.lookAt(lookTarget);
                } else {
                    // First Person on foot
                    camera.position.set(playerGroup.position.x, playerGroup.position.y + 1.5, playerGroup.position.z);
                    const lookX = playerGroup.position.x + Math.sin(state.camYaw);
                    const lookZ = playerGroup.position.z + Math.cos(state.camYaw);
                    camera.lookAt(lookX, playerGroup.position.y + 1.5, lookZ);
                }
            } else if (state.camMode === 2) {
                // CHT Engine Focus View
                const engineOffset = new THREE.Vector3(0, 1.8, 1.8).applyAxisAngle(new THREE.Vector3(0, 1, 0), fiatUno.rotation.y);
                camera.position.copy(fiatUno.position).add(engineOffset);
                camera.lookAt(fiatUno.position.x, fiatUno.position.y + 0.8, fiatUno.position.z + 1.1);
            }

            // Proximity UI Triggers
            const distToCar = playerGroup.position.distanceTo(fiatUno.position);
            btnEnter.style.display = (distToCar < 3.0 || state.inCar) ? 'flex' : 'none';

            const hoodWorldPos = fiatUno.position.clone().add(new THREE.Vector3(0, 0, 1.5));
            btnHood.style.display = (!state.inCar && playerGroup.position.distanceTo(hoodWorldPos) < 2.5) ? 'flex' : 'none';

            const tbWorldPos = new THREE.Vector3(-2.5, 0.9, -3.8);
            btnTool.style.display = (!state.hasToolbox && !state.inCar && playerGroup.position.distanceTo(tbWorldPos) < 2.5) ? 'flex' : 'none';

            // Warehouse Freight Trigger
            const warehousePos = new THREE.Vector3(-20, 0, 40);
            const distToWarehouse = (state.inCar ? fiatUno.position : playerGroup.position).distanceTo(warehousePos);
            
            // Supermarket Trigger
            const supermarketPos = new THREE.Vector3(22, 0, 60);
            const distToSupermarket = (state.inCar ? fiatUno.position : playerGroup.position).distanceTo(supermarketPos);

            if (distToWarehouse < 6.0 && !state.hasCargo) {
                btnFreight.innerText = "📦 PEGAR FRETE ($150)";
                btnFreight.style.display = 'flex';
            } else if (distToSupermarket < 8.0 && state.hasCargo) {
                btnFreight.innerText = "✅ ENTREGAR FRETE ($150)";
                btnFreight.style.display = 'flex';
            } else {
                btnFreight.style.display = 'none';
            }

            btnEat.style.display = (distToSupermarket < 8.0) ? 'flex' : 'none';

            // Slow Hunger Drain
            state.hunger = Math.max(0, state.hunger - delta * 0.2);
            hungerBar.style.width = `${state.hunger}%`;

            renderer.render(scene, camera);
        }

        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });

        // Start Loop
        animate();
    </script>
</body>
</html>
